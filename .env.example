# Fichier d'exemple de configuration
# Copiez ce fichier vers local.env et configurez vos valeurs

# Mode de développement : true pour local, false pour production
MODE_LOCAL=true

# Configuration locale (utilisé si MODE_LOCAL=true)
BASE_URL=http://1-ted.local
DB_HOST=localhost
DB_NAME=1ted
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Configuration production (utilisé seulement si MODE_LOCAL=false)
PROD_BASE_URL=https://votre-domaine.com
PROD_DB_HOST=votre_serveur_sql
PROD_DB_NAME=votre_base_prod
PROD_DB_USER=votre_user_prod
PROD_DB_PASSWORD=votre_password_prod
